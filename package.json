{
  "name": "todo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "db:generate": "pnpm --filter @todo/api db:generate",
    "db:migrate": "node scripts/db.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tests",
    "test": "vitest run --project unit",
    "test:api": "vitest run --project integration",
    "test:mock": "vitest run --project mock",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:api && pnpm test:mock && pnpm test:e2e",
    "db:migrate:test": "node scripts/db.mjs --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @todo/api dev",
    "dev:web": "pnpm --filter @todo/web dev",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "prettier": "3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
